rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /daily_leaderboards/{dayKey}/scores/{deviceId} {
      allow read: if true;
      allow create, update: if request.resource.data.device_id == deviceId
        && request.resource.data.day_key == dayKey
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() > 0
        && request.resource.data.display_name.size() <= 20
        && request.resource.data.display_name.matches('^[A-Za-z0-9_. -]+$')
        && request.resource.data.today_count is int
        && request.resource.data.today_count >= 0
        && request.resource.data.country_code is string
        && request.resource.data.country_code.size() <= 2
        && request.resource.data.keys().hasOnly([
          'device_id',
          'display_name',
          'today_count',
          'day_key',
          'country_code',
          'updated_at'
        ]);
    }

    match /profiles/{deviceId} {
      allow read: if true;
      allow create, update: if request.resource.data.device_id == deviceId
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() > 0
        && request.resource.data.display_name.size() <= 20
        && request.resource.data.country_code is string
        && request.resource.data.country_code.size() <= 2
        && request.resource.data.username_key is string
        && request.resource.data.keys().hasOnly([
          'device_id',
          'display_name',
          'country_code',
          'username_key',
          'updated_at'
        ]);
    }

    match /usernames/{usernameKey} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/usernames/$(usernameKey))
        && request.resource.data.normalized_name == usernameKey
        && request.resource.data.device_id is string
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() > 0
        && request.resource.data.display_name.size() <= 20
        && request.resource.data.keys().hasOnly([
          'normalized_name',
          'display_name',
          'device_id',
          'created_at'
        ]);
      allow update: if resource.data.device_id == request.resource.data.device_id
        && request.resource.data.normalized_name == usernameKey
        && request.resource.data.keys().hasOnly([
          'normalized_name',
          'display_name',
          'device_id',
          'created_at'
        ]);
    }
  }
}
