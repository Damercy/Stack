<resources>
    <style name="Theme.Stack.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F3E36B</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Stack</item>
    </style>

    <style name="Theme.Stack" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F3E36B</item>
        <item name="android:navigationBarColor">#F3E36B</item>
        <item name="android:statusBarColor">#F3E36B</item>
    </style>
</resources>
